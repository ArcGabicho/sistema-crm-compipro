# Imagen del backend (core/server). Contexto de build: la raíz del repositorio.

# --- Compilación ----------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

# Restaurar dependencias primero (cache de capas)
COPY core/server/server.csproj ./
RUN dotnet restore server.csproj

COPY core/server/ ./
RUN dotnet publish server.csproj -c Release -o /app --no-restore /p:UseAppHost=false

# --- Ejecución: solo el runtime de ASP.NET ---------------------------------------
# Imagen más chica = arranques en frío más rápidos (Azure Container Apps escala a cero).
FROM mcr.microsoft.com/dotnet/aspnet:10.0

WORKDIR /app
COPY --from=build /app ./

# Documentos con almacenamiento Local: carpeta escribible para el usuario sin root.
RUN mkdir -p /app/storage && chown "$APP_UID" /app/storage

ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_URLS=http://+:8080

USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "server.dll"]
