# Imagen del frontend (core/client, Next.js) — una sola etapa, para producción.
# Contexto de build: la raíz del repositorio.
FROM node:22-slim

WORKDIR /app

# Instalar dependencias (incluye devDeps: Next necesita TS/Tailwind/ESLint para compilar)
COPY core/client/package.json core/client/package-lock.json ./
RUN npm ci

# Código y build de producción
COPY core/client/ ./
RUN npm run build

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000
# `npm run start` -> `next start` (lee BACKEND_URL y AUTH_JWT_SECRET en runtime)
CMD ["npm", "run", "start"]