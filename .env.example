# Copia este archivo a .env (en la raíz) y ajusta los valores.
# Lo consumen: docker compose (--env-file), y scripts/*.sh para generar
# core/client/.env.local y core/server/appsettings.Development.json.

# --- Base de datos (Azure SQL) ---------------------------------------------------
# Cadena de conexión completa. Usa un usuario propio de la base (no el admin del servidor)
# y nunca subas la contraseña real al repositorio.
DB_CONNECTION_STRING='Server=tcp:<servidor>.database.windows.net,1433;Initial Catalog=<base>;User ID=<usuario>;Password=<contraseña>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;'

# --- Autenticación -----------------------------------------------------------
# Secreto de firma del JWT. DEBE ser idéntico en backend (Jwt__Key) y cliente (AUTH_JWT_SECRET).
JWT_KEY=fg9H65NPCIzoiY_4zmozOWfcVNmGZFsfSkp9EQUMNBw

# Usuario administrador que se siembra en la tabla Users en el primer arranque
SEED_ADMIN_EMAIL=admin@compipro.net
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_PASSWORD=Compipro2025!

# --- Correo (opcional) ---------------------------------------------------------
# Sin SMTP_HOST el envío de campañas y cotizaciones es simulado (se registra en el log).
# Sirve cualquier SMTP: Gmail (contraseña de aplicación), Brevo, Resend, SendGrid…
EMAIL_REMITENTE=crm@compipro.net
# URL pública del backend: activa el seguimiento de aperturas y clics en correos reales.
EMAIL_URL_PUBLICA=
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=

# --- Archivos de Documentos (opcional) -------------------------------------------
# Local = disco del servidor (volumen Docker "archivos"). S3 = Cloudflare R2, AWS S3, MinIO…
ALMACENAMIENTO=Local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Sitio web -----------------------------------------------------------------
# URL pública del sitio web (URLs canónicas, sitemap.xml y vistas previas al compartir)
SITE_URL=https://compipro.net
